{
  "name": "creative-thoughts",
  "version": "2.0.0",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:api": "npm run dev --workspace @creative-thoughts/api",
    "dev:web": "npm run dev --workspace @creative-thoughts/web",
    "dev:api:cloudflare": "npm run dev:cloudflare --workspace @creative-thoughts/api",
    "dev:web:cloudflare": "npm run dev:vinext --workspace @creative-thoughts/web",
    "seed": "npm run seed --workspace @creative-thoughts/api",
    "build:api": "npm run build --workspace @creative-thoughts/api",
    "build:web": "npm run build --workspace @creative-thoughts/web",
    "build:api:cloudflare": "npm run build:cloudflare --workspace @creative-thoughts/api",
    "build:web:cloudflare": "npm run build:vinext --workspace @creative-thoughts/web",
    "package:cloudflare": "node scripts/package-cloudflare.mjs",
    "start:api": "npm run start --workspace @creative-thoughts/api",
    "start:web": "npm run start --workspace @creative-thoughts/web",
    "preview:web:cloudflare": "npm run start:vinext --workspace @creative-thoughts/web",
    "deploy:api:cloudflare": "npm run deploy:cloudflare --workspace @creative-thoughts/api",
    "deploy:web:cloudflare": "npm run deploy:vinext --workspace @creative-thoughts/web",
    "typecheck:api": "npm run typecheck --workspace @creative-thoughts/api",
    "typecheck:web": "npm run typecheck --workspace @creative-thoughts/web"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
